# Copy to .env (git-ignored) and fill in to let astrolab log in to the ESA Gaia archive
# non-interactively. Leave empty to use the interactive `python -m astrolab gaia-login` instead.
# Environment variables of the same names take precedence over this file.
# Note: the project folder may be synced (e.g. Dropbox); prefer setting the environment variables
# if you do not want the password in a synced file.
GAIA_USERNAME=
GAIA_PASSWORD=
